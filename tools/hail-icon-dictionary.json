{
  "about": "Icon dictionary for the Hail (Mercenary Pack) ability cards, from the trial extraction. Entries are tried in order, the first whose `match` (case-insensitive regular expressions) hits a description wins. `source`: user = given by the owner, sheet = matched against HavenMap's own icon images (images/icons/conditions-*, attack-modifiers/common/icons/center/conditions-*, Wordhaven_Assets/MP/abilities), context = read from the card text around the icon, guess = best reading, to confirm.",
  "entries": [
    {
      "id": "irritation",
      "type": "irritation",
      "token": "irritation",
      "source": "sheet",
      "label": "Irritation: the name of a persistent effect, printed on a ribbon (white head with a burst); not a resource",
      "match": [
        "ribbon",
        "label",
        "\\btag\\b"
      ]
    },
    {
      "id": "resolve",
      "type": "resolve",
      "token": "resolve",
      "source": "sheet",
      "label": "Resolve, the class resource (white head silhouette with a star on the chest, also in a circle); the cost in a dashed pill",
      "match": [
        "irritation icon",
        "head silhouette with star",
        "person silhouette in white circle",
        "hail resource",
        "white round person",
        "person-in-circle",
        "resolve"
      ]
    },
    {
      "id": "move",
      "type": "move",
      "token": "move",
      "source": "user",
      "label": "Move (white boot with speed lines)",
      "match": [
        "boot",
        "speed lines",
        "^move$",
        "move icon"
      ]
    },
    {
      "id": "attack",
      "type": "attack",
      "token": "attack",
      "source": "user",
      "label": "Attack (white wand with sparkles)",
      "match": [
        "wand",
        "^attack( icon)?$"
      ]
    },
    {
      "id": "pierce",
      "type": "pierce",
      "token": "pierce",
      "source": "sheet",
